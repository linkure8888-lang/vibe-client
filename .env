# Vibe Client — secrets & API config
# NEVER commit this file to git. It is listed in .gitignore.
# Values are read by VibeClient at startup (Env.kt). Empty = feature disabled.

# ---------------------------------------------------------------------------
# MODRINTH (mod store catalog + downloads)
# Public API, no key required. Optional PAT raises rate limit (300/min -> more).
# https://modrinth.com/settings/pats  (token must start with "mrp_")
# Leave empty to use the anonymous rate limit.
# ---------------------------------------------------------------------------
MODRINTH_TOKEN=

# ---------------------------------------------------------------------------
# CURSEFORGE (optional second catalog; requires an API key from console.curseforge.com)
# Leave empty to disable CurseForge as a source.
# ---------------------------------------------------------------------------
CURSEFORGE_API_KEY=

# ---------------------------------------------------------------------------
# SERVER / VIBENETWORK (future; only used when launching our own server)
# ---------------------------------------------------------------------------
VIBE_SERVER_HOST=
VIBE_SERVER_PORT=25565

# ---------------------------------------------------------------------------
# MISC
# ---------------------------------------------------------------------------
# Target Minecraft version used by the mod store dropdown default.
DEFAULT_MC_VERSION=1.21.1
# Debug logging (true/false). Keep false for release builds.
VIBE_DEBUG=false
