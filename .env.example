# Vibe Client — template for .env
# Copy this file to `.env` and fill in the values you actually need.
# `.env` is git-ignored; `.env.example` is safe to commit.
#
# On Windows PowerShell:
#   Copy-Item .env.example .env
#   notepad .env

# ---------------------------------------------------------------------------
# MODRINTH (mod store catalog + downloads)
# Public API needs NO key. A Personal Access Token only raises the rate limit.
# Create one at https://modrinth.com/settings/pats  (starts with "mrp_")
# Leave empty to stay anonymous.
# ---------------------------------------------------------------------------
MODRINTH_TOKEN=

# ---------------------------------------------------------------------------
# CURSEFORGE (optional second catalog)
# API key from https://console.curseforge.com/
# Leave empty to disable CurseForge as a source.
# ---------------------------------------------------------------------------
CURSEFORGE_API_KEY=

# ---------------------------------------------------------------------------
# VIBENETWORK (future own server)
# ---------------------------------------------------------------------------
VIBE_SERVER_HOST=
VIBE_SERVER_PORT=25565

# ---------------------------------------------------------------------------
# MISC
# ---------------------------------------------------------------------------
# Default Minecraft version selected in the mod store dropdown.
DEFAULT_MC_VERSION=1.21.1
# Verbose logging. Keep false for release builds.
VIBE_DEBUG=false