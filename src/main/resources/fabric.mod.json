{
  "schemaVersion": 1,
  "id": "vibeclient",
  "version": "${version}",
  "name": "Vibe Client",
  "description": "A lightweight Badlion/Lunar style client mod built from scratch.",
  "authors": [
    "Vibe"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/vibeclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.vibe.client.VibeClient"
      }
    ]
  },
  "mixins": [
    "vibeclient.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21 <1.22",
    "java": ">=21",
    "fabric-language-kotlin": ">=1.12.0",
    "fabric-api": ">=0.100.0"
  }
}
